# ============================================================
# MessageTodo environment variables
# Copy to your own local files and fill real values.
# NEVER commit real keys. Keep the .env.example files committed.
# ============================================================

# --- Supabase ---
# Local (Docker + Supabase CLI):  http://127.0.0.1:54321
# Cloud:                          https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, never exposed to clients

# --- Web Push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                  # server-only

# --- App ---
APP_BASE_URL=http://localhost:3000
